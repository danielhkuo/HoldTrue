{
  "name": "holdtrue",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first study application",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "demo": "npx --yes tsx src/feynman/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:red": "vitest run --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "mutate": "stryker run",
    "mutate:incremental": "stryker run --incremental",
    "rig": "npx --yes tsx src/feynman/rig.ts",
    "app": "npx --yes tsx src/app/server.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.2.0",
    "@stryker-mutator/vitest-runner": "^9.2.0",
    "@types/node": "^24.3.0",
    "electron": "^43.3.0",
    "fast-check": "^4.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
