{
  "name": "holdtrue",
  "version": "0.0.0",
  "private": true,
  "description": "A study application. You explain a mechanism out loud, and a model finds the step you skipped.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "app": "npx --yes tsx src/server.ts",
    "rig": "npx --yes tsx src/rig.ts",
    "e2e": "vite-node src/e2e.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.2.0",
    "@stryker-mutator/vitest-runner": "^9.2.0",
    "@types/node": "^24.3.0",
    "electron": "^43.3.0",
    "fast-check": "^4.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
