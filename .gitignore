# macOS
.DS_Store

# Node. package-lock.json IS tracked — it pins the exact Electron/Node toolchain
# the FTS5 verification in AGENTS.md was measured against.
node_modules/
.vitest/
coverage/
.stryker-tmp/
reports/
dist/
out/

# Claude Code local state. .claude/skills/ IS tracked (project skills like
# verify), so these must be listed here rather than in .git/info/exclude —
# that file is local-only and a fresh clone would start tracking them.
.claude/settings.local.json
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock
.claude/routines/.state/
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/agent-memory-local
.claude/first-run
.claude/assistant-daemon-state.json

# Agent scratch output
.superpowers/

# Xcode user-specific state
xcuserdata/
*.xcuserstate

# Xcode / Swift build artifacts
DerivedData/
.build/
*.ipa
*.dSYM.zip
*.dSYM

# codebase-memory-mcp local index (optional team artifact: .codebase-memory/graph.db.zst)
.codebase-memory/
.gstack/

# Third-party transcripts, kept locally as test material only. This repo is public,
# and a full transcript of somebody else's talk is their copyright, not ours. Short
# excerpts used as segmentation fixtures are committed; the whole file is not.
re.txt
transcripts-local/

# Secrets — never commit. Templates live in .env.example (committed).
.env
.env.keys
.env.local
.env.*.local
